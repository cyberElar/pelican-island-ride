{
  "name": "pelican-island",
  "version": "1.1.1",
  "description": "Pelican Island Ride - a cinematic three.js cycling showcase",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "build:quick": "node tools/build.mjs --quick",
    "build:publish": "node tools/build.mjs --publish",
    "shot": "node tools/screenshot.mjs",
    "shots:readme": "node tools/dev/make-readme-shots.mjs",
    "test": "node tools/dev/test-all.mjs",
    "smoke": "node tools/dev/smoke-ci.mjs",
    "smoke:firefox": "node tools/dev/smoke-ci.mjs --browser firefox",
    "smoke:webkit": "node tools/dev/smoke-ci.mjs --browser webkit",
    "smoke:cross": "node tools/dev/smoke-ci.mjs --browser chromium && node tools/dev/smoke-ci.mjs --browser firefox && node tools/dev/smoke-ci.mjs --browser webkit",
    "serve": "node tools/serve.mjs"
  },
  "keywords": [],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "esbuild": "^0.28.2",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "jsdom": "^30.1.2",
    "playwright-core": "^1.64.0"
  }
}
